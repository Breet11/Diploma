<configuration>
    <property name="LOG_DIR" value="logs"/>

    <appender name="SIFT" class="ch.qos.logback.classic.sift.SiftingAppender">
        <discriminator class="com.example.diploma.utils.LoggerNameDiscriminator">
            <key>classLog</key>
            <defaultValue>application</defaultValue>
        </discriminator>
        <sift>
            <appender name="FILE-${classLog}" class="ch.qos.logback.core.rolling.RollingFileAppender">
                <file>${LOG_DIR}/${classLog}.log</file>
                <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                    <fileNamePattern>${LOG_DIR}/${classLog}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                    <maxFileSize>10MB</maxFileSize>
                    <maxHistory>14</maxHistory>
                    <totalSizeCap>1GB</totalSizeCap>
                </rollingPolicy>
                <filter class="ch.qos.logback.classic.filter.LevelFilter">
                    <level>INFO</level>
                    <onMatch>ACCEPT</onMatch>
                    <onMismatch>DENY</onMismatch>
                </filter>
                <encoder>
                    <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger - %msg%n</pattern>
                </encoder>
            </appender>
        </sift>
    </appender>

    <logger name="com.example.diploma" level="INFO" additivity="false">
        <appender-ref ref="SIFT"/>
    </logger>

    <root level="WARN"/>
</configuration>

