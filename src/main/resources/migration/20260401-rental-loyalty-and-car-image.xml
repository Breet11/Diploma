<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260401-1-add-car-image" author="vrijenco">
        <addColumn tableName="dip_car">
            <column name="image_url" type="VARCHAR(500)" defaultValue="https://images.unsplash.com/photo-1492144534655-ae79c964c9d7"/>
        </addColumn>
        <addNotNullConstraint tableName="dip_car" columnName="image_url" columnDataType="VARCHAR(500)"/>
    </changeSet>

    <changeSet id="20260401-2-create-loyalty-rule" author="vrijenco">
        <createTable tableName="dip_rental_loyalty_rule">
            <column name="uuid" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_dip_rental_loyalty_rule"/>
            </column>
            <column name="min_hours" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="max_hours" type="BIGINT"/>
            <column name="multiplier" type="DECIMAL(8,4)">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260401-3-create-rental-order" author="vrijenco">
        <createTable tableName="dip_rental_order">
            <column name="uuid" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_dip_rental_order"/>
            </column>
            <column name="car_uuid" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="user_uuid" type="UUID"/>
            <column name="first_name" type="VARCHAR(255)"/>
            <column name="last_name" type="VARCHAR(255)"/>
            <column name="phone" type="VARCHAR(255)"/>
            <column name="hours" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="total_price" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="dip_rental_order"
                                 baseColumnNames="car_uuid"
                                 referencedTableName="dip_car"
                                 referencedColumnNames="uuid"
                                 constraintName="fk_dip_rental_order_car"/>

        <addForeignKeyConstraint baseTableName="dip_rental_order"
                                 baseColumnNames="user_uuid"
                                 referencedTableName="dip_user"
                                 referencedColumnNames="uuid"
                                 constraintName="fk_dip_rental_order_user"/>
    </changeSet>

    <changeSet id="20260401-4-seed-loyalty-rules" author="vrijenco">
        <insert tableName="dip_rental_loyalty_rule">
            <column name="uuid" value="11111111-1111-1111-1111-111111111111"/>
            <column name="min_hours" valueNumeric="1"/>
            <column name="max_hours" valueNumeric="23"/>
            <column name="multiplier" valueNumeric="1.0000"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="dip_rental_loyalty_rule">
            <column name="uuid" value="22222222-2222-2222-2222-222222222222"/>
            <column name="min_hours" valueNumeric="24"/>
            <column name="max_hours" valueNumeric="71"/>
            <column name="multiplier" valueNumeric="0.9300"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="dip_rental_loyalty_rule">
            <column name="uuid" value="33333333-3333-3333-3333-333333333333"/>
            <column name="min_hours" valueNumeric="72"/>
            <column name="max_hours" valueNumeric="167"/>
            <column name="multiplier" valueNumeric="0.8600"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="dip_rental_loyalty_rule">
            <column name="uuid" value="44444444-4444-4444-4444-444444444444"/>
            <column name="min_hours" valueNumeric="168"/>
            <column name="multiplier" valueNumeric="0.8000"/>
            <column name="active" valueBoolean="true"/>
        </insert>
    </changeSet>
</databaseChangeLog>

